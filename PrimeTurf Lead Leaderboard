#ptlb .stat .value { font-family: var(--font-anthropic-serif), 'Cormorant Garamond', Georgia, serif; font-size: 26px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.1; color: var(--color-fg); }

#ptlb .stat .value small { font-size: 13px; font-weight: 500; color: var(--color-fg-muted); font-family: var(--font-anthropic-sans), Montserrat, sans-serif; }

#ptlb .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }

#ptlb .filter-btn { font-family: inherit; font-size: 12.5px; font-weight: 600; letter-spacing: 0.02em; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--color-border-line); background: var(--color-panel); color: var(--color-fg-muted); cursor: pointer; }

#ptlb .filter-btn[aria-pressed="true"] { background: var(--pt-green); border-color: var(--pt-green); color: rgb(255, 255, 255); }

#ptlb .hint { font-size: 12px; color: var(--color-fg-muted); margin-bottom: 14px; }

#ptlb .table-wrap { overflow-x: auto; border: 1px solid var(--color-border-line); border-radius: 10px; }

#ptlb table { border-collapse: collapse; width: 100%; min-width: 760px; font-size: 13.5px; }

#ptlb thead th { text-align: left; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-fg-muted); background: var(--color-panel); padding: 10px 12px; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }

#ptlb tbody td { padding: 10px 12px; border-bottom: 1px solid var(--color-border-line); vertical-align: middle; }

#ptlb tbody tr.lead-row { cursor: pointer; }

#ptlb tbody tr.lead-row:hover td { background: color-mix(in srgb, var(--pt-green) 6%, transparent); }

#ptlb tbody tr.lead-row[aria-expanded="true"] td { background: color-mix(in srgb, var(--pt-green) 9%, transparent); }

#ptlb tbody tr:last-child td { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

#ptlb .rank { font-family: var(--font-anthropic-serif), 'Cormorant Garamond', Georgia, serif; font-weight: 600; color: var(--color-fg-muted); text-align: right; width: 1%; }

#ptlb .name { font-weight: 600; min-width: 200px; }

#ptlb .name .meta { font-weight: 400; font-size: 11.5px; color: var(--color-fg-muted); margin-top: 2px; }

#ptlb .loc { color: var(--color-fg-muted); min-width: 180px; }

#ptlb .score { font-family: var(--font-anthropic-serif), 'Cormorant Garamond', Georgia, serif; font-weight: 700; font-size: 16px; font-variant-numeric: tabular-nums; }

#ptlb .caret { color: var(--color-fg-muted); font-size: 11px; width: 1%; text-align: center; }

#ptlb .pill { display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }

#ptlb .type-buyer { background: color-mix(in srgb, var(--pt-green) 16%, transparent); color: var(--pt-green); }

#ptlb .type-affiliate { background: color-mix(in srgb, var(--pt-gold) 22%, transparent); color: var(--pt-gold-text); }

#ptlb .band-hot { background: color-mix(in srgb, rgb(194, 59, 34) 16%, transparent 84%); color: rgb(194, 59, 34); }

#ptlb .band-high { background: color-mix(in srgb, var(--pt-gold) 24%, transparent); color: var(--pt-gold-text); }

#ptlb .band-qualified { background: color-mix(in srgb, var(--pt-green) 16%, transparent); color: var(--pt-green); }

#ptlb .band-lost { background: var(--color-border-line); color: var(--color-fg-muted); }

@media (prefers-color-scheme: dark) {
  #ptlb .band-hot { color: rgb(255, 138, 104); }
  #ptlb .type-buyer { color: rgb(111, 207, 138); }
}

#ptlb .detail-row td { padding: 0px; border-bottom: 1px solid var(--color-border-line); }

#ptlb .detail { padding: 18px 20px 22px; background: var(--color-panel); display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 14px 24px; }

#ptlb .detail-field { min-width: 0px; }

#ptlb .detail-field .dlabel { font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--pt-gold-text); margin-bottom: 4px; }

#ptlb .detail-field .dvalue { font-size: 13.5px; line-height: 1.5; color: var(--color-fg); overflow-wrap: anywhere; }

#ptlb .detail-field.full { grid-column: 1 / -1; }

#ptlb .opening-box { background: var(--color-bg); border: 1px solid var(--color-border-line); border-radius: 8px; padding: 12px 14px; font-family: var(--font-anthropic-serif), 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 14.5px; line-height: 1.55; color: var(--color-fg); }

#ptlb .copy-btn { font-family: inherit; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 5px 11px; margin-top: 8px; border-radius: 6px; border: 1px solid var(--pt-green); background: transparent; color: var(--pt-green); cursor: pointer; }

#ptlb .copy-btn.copied { background: var(--pt-green); color: rgb(255, 255, 255); }

@media (max-width: 560px) {
  #ptlb .detail { grid-template-columns: 1fr; }
}

#ptlb .foot-note { margin-top: 16px; font-size: 12px; color: var(--color-fg-muted); line-height: 1.5; }
